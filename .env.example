# =============================================================================
# CRAVORA — PIZZA & MORE | Environment Configuration Template
# Copy this file to .env in the project root or backend/ directory
# =============================================================================

# --- Application ---
APP_NAME="CRAVORA — Pizza & More API"
APP_ENV="development"
APP_VERSION="1.0.0"

# --- Database ---
# For Docker / Production PostgreSQL:
# DATABASE_URL="postgresql+psycopg://cravora:cravora_secret@localhost:5432/cravora"
# For Local Zero-Config SQLite Fallback (with PRAGMA foreign_keys=ON):
DATABASE_URL="sqlite:///./cravora.db"

# --- Security & JWT ---
JWT_SECRET_KEY="replace-with-a-strong-random-64-byte-secret-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS ---
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# --- Tax & Loyalty Policies ---
TAX_RATE_PERCENT=16
LOYALTY_POINTS_PER_100_PKR=5
LOYALTY_PKR_PER_POINT=1

# --- Cravora AI Concierge (Server-side only — never expose in frontend) ---
LLM_PROVIDER="openai"
LLM_MODEL="gpt-4o-mini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
AI_TIMEOUT_SECONDS=20.0
AI_MAX_RETRIES=2

# --- Maps & Geocoding ---
MAPS_PROVIDER="osm_nominatim"
GOOGLE_MAPS_SERVER_API_KEY=""
MAPBOX_ACCESS_TOKEN=""
VITE_GOOGLE_MAPS_BROWSER_KEY=""

# --- Payment Gateways (Server-side only) ---
SAFEPAY_MERCHANT_KEY=""
SAFEPAY_WEBHOOK_SECRET="cravora-webhook-hmac-secret-dev"
JAZZCASH_MERCHANT_ID=""
EASYPAISA_STORE_ID=""

# --- Notifications (SMTP / SMS / WhatsApp) ---
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMS_API_KEY=""
WHATSAPP_BUSINESS_TOKEN=""

# --- Customer Care Escalation Contacts ---
SUPPORT_PHONE="+92 (51) 111-272-867"
SUPPORT_EMAIL="care@cravora.pk"
SUPPORT_WHATSAPP="+92 300 1112728"

# --- Frontend API Base URL ---
VITE_API_BASE_URL="http://localhost:8000"
